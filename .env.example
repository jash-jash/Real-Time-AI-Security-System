# Gmail account that sends security alerts
SECURITY_EMAIL=realtimesecuritysystem@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# Create at: https://myaccount.google.com/apppasswords
SECURITY_EMAIL_PASSWORD=your-16-char-app-password-here

# Who receives alert emails (up to 2 addresses)
SECURITY_ALERT_RECIPIENT=jashwanthinsrirama@gmail.com
SECURITY_ALERT_RECIPIENT_2=

# Camera source:
# 0 = local laptop webcam (only works when this PC is on)
# For always-online cloud hosting, use an IP/RTSP camera URL, example:
# CAMERA_SOURCE=rtsp://username:password@CAMERA_IP:554/stream1
CAMERA_SOURCE=0

# Website-only cloud mode (Render): set true to skip heavy AI models
WEB_ONLY=false

PORT=5000
